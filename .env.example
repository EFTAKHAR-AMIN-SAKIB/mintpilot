# MintPilot Environment Configuration Example
# Copy this file to .env.local to configure your local development environment.

# -----------------------------------------------------------------------------
# Google Gemini Natural Language Processing
# -----------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Binance Agentic Wallet Integration
# -----------------------------------------------------------------------------
# Integration mode:
# - auto: automatically attempts Binance Agentic Wallet CLI (`baw`), falls back to clearly-labeled Dev Mode if CLI unlinked
# - cli: strictly uses official `@binance/agentic-wallet` CLI
# - dev: runs in development simulated mode (with realistic QR pairing & simulation, clearly labeled)
BINANCE_AGENTIC_WALLET_MODE=auto

# Production safety flag:
# When false (default), real on-chain checks and Binance sign-in are prioritized
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Network & RPC Configuration (BNB Smart Chain)
# -----------------------------------------------------------------------------
# Chain mode: "mainnet" (Chain ID 56) or "testnet" (Chain ID 97)
CHAIN_MODE=mainnet

# RPC URLs:
# Mainnet: https://bsc-dataseed.binance.org/
# Testnet: https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/

# BscScan Explorer API (Optional - used for verified contract ABI lookups)
BSCSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_SECRET=mintpilot_secure_session_secret_change_in_production_min32chars
